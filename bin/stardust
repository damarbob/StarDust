#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * StarDust CLI entry point (ADR 0026).
 *
 * Current surface: --version, --help, bootstrap, watcher, reconciler,
 * reconciler:dlq:replay, liberator, chronicler.
 *
 * Exit codes:
 *   0  clean exit (incl. signal-induced shutdown)
 *   1  fatal error (bootstrap / daemon)
 *   2  user error (singleton violation, missing env vars, unknown command)
 */

$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',           // running from the repo
    __DIR__ . '/../../../autoload.php',            // running as a vendored bin
    __DIR__ . '/../../autoload.php',               // running from a flat composer install
];

$autoloadLoaded = false;
foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        require $candidate;
        $autoloadLoaded = true;
        break;
    }
}

if (! $autoloadLoaded) {
    fwrite(STDERR, "stardust: could not locate vendor/autoload.php; run `composer install`.\n");
    exit(1);
}

$argv    = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? '--help';

/** Standard PDO driver options — shared by the primary connection and the reconnect factory. */
$pdoOptions = [
    PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_EMULATE_PREPARES   => false,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
];

/**
 * Reads and validates the standard DB env vars, exiting non-zero on
 * misconfiguration.
 *
 * @return array{string, string, string} [dsn, user, pass]
 */
$readDbEnv = static function (): array {
    $dsn  = getenv('STARDUST_DSN') ?: '';
    $user = getenv('STARDUST_USER') ?: '';
    $pass = getenv('STARDUST_PASS');
    $pass = $pass === false ? '' : $pass;

    if ($dsn === '' || $user === '') {
        fwrite(
            STDERR,
            "stardust: STARDUST_DSN and STARDUST_USER environment variables are required.\n"
                . "STARDUST_PASS is optional (defaults to empty).\n",
        );
        exit(2);
    }

    return [$dsn, $user, $pass];
};

/** Builds a PDO from the standard env vars, exiting non-zero on misconfiguration. */
$buildPdo = static function () use ($readDbEnv, $pdoOptions): PDO {
    [$dsn, $user, $pass] = $readDbEnv();
    return new PDO($dsn, $user, $pass, $pdoOptions);
};

/**
 * Builds a reconnect factory from the same env vars so the Chronicler
 * can re-establish a dropped connection mid-export (ADR 0025).
 */
$buildConnector = static function () use ($readDbEnv, $pdoOptions): \StarDust\Chronicler\DsnPdoConnector {
    [$dsn, $user, $pass] = $readDbEnv();
    return new \StarDust\Chronicler\DsnPdoConnector($dsn, $user, $pass, $pdoOptions);
};

/** Parses `--key=value` style args into a map. */
$parseFlags = static function (array $args): array {
    $out = [];
    foreach ($args as $arg) {
        if (! is_string($arg) || ! str_starts_with($arg, '--')) {
            continue;
        }
        $body = substr($arg, 2);
        $eq = strpos($body, '=');
        if ($eq === false) {
            $out[$body] = true;
        } else {
            $out[substr($body, 0, $eq)] = substr($body, $eq + 1);
        }
    }
    return $out;
};

switch ($command) {
    case '--version':
    case '-V':
        echo \StarDust\StarDust::VERSION . "\n";
        exit(0);

    case '--help':
    case '-h':
        echo <<<HELP
        stardust — Vertical Schema Partitioning engine CLI

        Usage:
          bin/stardust <command> [options]

        Current command surface:
          --version, -V    Print the engine version.
          --help, -h       Show this help.
          bootstrap        Apply the Phase 1 schema (idempotent).
                           Reads STARDUST_DSN, STARDUST_USER, STARDUST_PASS
                           from the process environment.
          watcher          Singleton page-provisioning daemon (Phase 5).
          reconciler       Multi-worker sync-queue + import-job drain
                           daemon (Phase 5).
          reconciler:dlq:replay --id=N | --reason=X
                           Operator-initiated DLQ replay (Phase 5).
          liberator        Multi-worker slot-reclamation daemon (Phase 6a):
                           sweeps tombstoned slots back to free. Run
                           multiple processes for horizontal scale.
          chronicler       Multi-worker async export daemon (Phase 7):
                           claims pending export jobs, paginates entry_data,
                           writes CSV/JSON artifacts under Config::artifactDir.
                           A shutdown request yields at the next chunk
                           boundary rather than blocking until the job
                           finishes (ADR 0050).
          spread:report [--tenant=N] [--model=N]
                           Report how many extension pages each model's
                           filterable slots occupy, and how many of those
                           are avoidable. Registry-only and read-only;
                           safe against production at any time.
          compact:model --tenant=N --model=N [--dry-run]
                           Relocate one model's filterable slots onto the
                           fewest pages that can hold them. Long-running:
                           moves one field at a time and needs a running
                           reconciler to make progress. Filters on the
                           in-flight field are rejected until it lands;
                           reads keep working. Safe to re-run.
          tick [--budget=N] [--advisories] [--exports]
                           Bounded, single-process pass of the Watcher,
                           Liberator and Reconciler over one connection —
                           for a cron line or scheduled URL fetch on a
                           host with no persistent-process capability.
                           Runs until its time budget is spent, a round
                           finds nothing to do, or it is asked to shut
                           down. --advisories forces the cardinality and
                           spread samplers once; run it from a separate,
                           once-daily crontab line. --exports opts the
                           Chronicler into the run (ADR 0050): a large
                           export yields back to `pending` at a chunk
                           boundary once this run's own budget deadline
                           is reached, resuming on a later tick from its
                           verified byte anchor. Off by default — see
                           docs/deployment.md before enabling it on a
                           host with a per-account disk quota.

        Subsequent phases are tracked in the project's design notes.
        HELP;
        echo "\n";
        exit(0);

    case 'bootstrap':
        try {
            $pdo = $buildPdo();
            (new \StarDust\StarDust(new \StarDust\Config\Config(pdo: $pdo)))->bootstrap();
            echo "stardust: bootstrap complete.\n";
            exit(0);
        } catch (\Throwable $e) {
            fwrite(STDERR, "stardust: bootstrap failed: " . $e->getMessage() . "\n");
            exit(1);
        }

    case 'watcher':
        try {
            $pdo = $buildPdo();
            $stardust = new \StarDust\StarDust(new \StarDust\Config\Config(pdo: $pdo));
            $guard = \StarDust\Daemon\PidFileGuard::acquire(
                $stardust->config()->pidFileDir,
                'watcher',
            );
            try {
                $stardust->pollLoop()->run(
                    $stardust->watcher(),
                    $stardust->shutdownSignal('watcher'),
                    $stardust->config()->watcherPollIntervalSeconds,
                );
                exit(0);
            } finally {
                $guard->release();
            }
        } catch (\StarDust\Exception\WatcherSingletonViolationException $e) {
            fwrite(STDERR, "stardust: " . $e->getMessage() . "\n");
            exit(2);
        } catch (\Throwable $e) {
            fwrite(STDERR, "stardust: watcher failed: " . $e->getMessage() . "\n");
            exit(1);
        }

    case 'reconciler':
        try {
            $pdo = $buildPdo();
            $stardust = new \StarDust\StarDust(new \StarDust\Config\Config(pdo: $pdo));
            // Reconciler is multi-worker safe (SKIP LOCKED + atomic
            // claim UPDATE) — no PID guard. Tick the loop continuously
            // (intervalSeconds = 0); the daemon itself sleeps via
            // capacity_wait when both work sources are idle.
            $stardust->pollLoop()->run(
                $stardust->reconciler(),
                $stardust->shutdownSignal('reconciler'),
                0,
            );
            exit(0);
        } catch (\Throwable $e) {
            fwrite(STDERR, "stardust: reconciler failed: " . $e->getMessage() . "\n");
            exit(1);
        }

    case 'liberator':
        try {
            $pdo = $buildPdo();
            $stardust = new \StarDust\StarDust(new \StarDust\Config\Config(pdo: $pdo));
            // Liberator is multi-worker safe since ADR 0049
            // (page-table-granularity GET_LOCK exclusion via
            // SweepPageLock) — no PID guard. Tick the loop continuously
            // at the configured idle interval, same as before.
            $stardust->pollLoop()->run(
                $stardust->liberator(),
                $stardust->shutdownSignal('liberator'),
                $stardust->config()->liberatorIdleIntervalSeconds,
            );
            exit(0);
        } catch (\Throwable $e) {
            fwrite(STDERR, "stardust: liberator failed: " . $e->getMessage() . "\n");
            exit(1);
        }

    case 'chronicler':
        try {
            $pdo = $buildPdo();
            // Wire the reconnect factory so a transient DB disconnect
            // mid-export is recovered in-process (ADR 0025).
            $stardust = new \StarDust\StarDust(new \StarDust\Config\Config(
                pdo: $pdo,
                pdoConnector: $buildConnector(),
            ));
            // Chronicler is multi-worker safe (SELECT … FOR UPDATE
            // SKIP LOCKED on stardust_export_jobs) — no PID guard.
            // The poll interval is the idle interval; per-job work
            // runs synchronously inside one tick.
            //
            // ADR 0050: the SAME shutdown signal instance is passed to
            // both chronicler() (wrapped as its cooperative-yield
            // signal, so a shutdown request lands mid-export at the
            // next chunk boundary rather than blocking until the job
            // finishes) and pollLoop()->run() — shutdownSignal() mints
            // a fresh composite per call, so building it once here is
            // load-bearing, not tidiness.
            $shutdown = $stardust->shutdownSignal('chronicler');
            $stardust->pollLoop()->run(
                $stardust->chronicler($shutdown),
                $shutdown,
                $stardust->config()->chroniclerIdleIntervalSeconds,
            );
            exit(0);
        } catch (\Throwable $e) {
            fwrite(STDERR, "stardust: chronicler failed: " . $e->getMessage() . "\n");
            exit(1);
        }

    case 'reconciler:dlq:replay':
        try {
            $flags = $parseFlags(array_slice($argv, 2));
            $id     = isset($flags['id'])     && is_string($flags['id'])     ? (int) $flags['id']     : null;
            $reason = isset($flags['reason']) && is_string($flags['reason']) ? $flags['reason']       : null;

            if ($id === null && $reason === null) {
                fwrite(STDERR, "stardust: reconciler:dlq:replay requires --id=N or --reason=X.\n");
                exit(2);
            }

            $pdo = $buildPdo();
            $stardust = new \StarDust\StarDust(new \StarDust\Config\Config(pdo: $pdo));
            $manifest = $id !== null
                ? $stardust->dlqReplayer()->replayById($id)
                : $stardust->dlqReplayer()->replayByReason($reason);

            $entryIds = implode(',', $manifest->entryIds);
            echo "stardust: replayed {$manifest->count()} DLQ row(s); re-enqueued entry_ids=[{$entryIds}]\n";
            exit(0);
        } catch (\StarDust\Exception\DlqReplayNotFoundException $e) {
            fwrite(STDERR, "stardust: " . $e->getMessage() . "\n");
            exit(1);
        } catch (\Throwable $e) {
            fwrite(STDERR, "stardust: reconciler:dlq:replay failed: " . $e->getMessage() . "\n");
            exit(1);
        }

    case 'compact:model':
        try {
            $flags = $parseFlags(array_slice($argv, 2));
            $tenantId = isset($flags['tenant']) && is_string($flags['tenant']) ? (int) $flags['tenant'] : null;
            $modelId  = isset($flags['model'])  && is_string($flags['model'])  ? (int) $flags['model']  : null;
            $dryRun   = isset($flags['dry-run']);

            if ($tenantId === null || $modelId === null) {
                fwrite(STDERR, "stardust: compact:model requires --tenant=N and --model=N.\n");
                exit(2);
            }

            $pdo = $buildPdo();
            $stardust = new \StarDust\StarDust(new \StarDust\Config\Config(pdo: $pdo));
            $plan = $stardust->compactModel($tenantId, $modelId, $dryRun);

            printf(
                "stardust: model %d (tenant %d) occupies %d page(s); floor is %d.\n",
                $modelId,
                $tenantId,
                $plan->pagesBefore,
                $plan->theoreticalMinPages,
            );

            if ($plan->isNoop()) {
                echo "stardust: nothing to relocate — the model is already as compact as the"
                    . " pages it occupies allow.\n";
                exit(0);
            }

            printf(
                "stardust: target page(s) [%s]; %d field(s) to relocate, %d already in place.\n",
                implode(',', $plan->targetPageIds),
                $plan->relocationCount(),
                $plan->noopCount,
            );
            foreach ($plan->relocations as $relocation) {
                printf(
                    "  %-24s %-4s page %d -> page %d\n",
                    $relocation->fieldName,
                    $relocation->slotType,
                    $relocation->fromPageId,
                    $relocation->toPageId,
                );
            }

            if ($dryRun) {
                // Nothing was mutated and no event was emitted — an event
                // describing an uncommitted plan would be a lie.
                echo "stardust: dry run — nothing was mutated.\n";
                exit(0);
            }

            printf(
                "stardust: compaction complete; model now occupies %d page(s).\n",
                $plan->pagesAfter(),
            );
            exit(0);
        } catch (\StarDust\Exception\CompactionCapacityException $e) {
            fwrite(STDERR, "stardust: " . $e->getMessage() . "\n");
            exit(1);
        } catch (\Throwable $e) {
            fwrite(STDERR, "stardust: compact:model failed: " . $e->getMessage() . "\n");
            exit(1);
        }

    case 'spread:report':
        try {
            $flags = $parseFlags(array_slice($argv, 2));
            $tenantId = isset($flags['tenant']) && is_string($flags['tenant']) ? (int) $flags['tenant'] : null;
            $modelId  = isset($flags['model'])  && is_string($flags['model'])  ? (int) $flags['model']  : null;

            $pdo = $buildPdo();
            $stardust = new \StarDust\StarDust(new \StarDust\Config\Config(pdo: $pdo));
            $samples = $stardust->spreadSampler()->report($tenantId, $modelId);

            if ($samples === []) {
                echo "stardust: no model has a live filterable slot in that scope.\n";
                exit(0);
            }

            // Read excess_pages, not pages_occupied: a model that
            // genuinely needs three pages reports excess 0 and wants
            // nothing from the operator.
            printf("%-10s %-10s %-8s %-10s %-8s %s\n",
                'TENANT', 'MODEL', 'PAGES', 'MIN_PAGES', 'EXCESS', 'LIVE_SLOTS');
            foreach ($samples as $sample) {
                printf("%-10d %-10d %-8d %-10d %-8d %d\n",
                    $sample->tenantId,
                    $sample->modelId,
                    $sample->pagesOccupied,
                    $sample->theoreticalMinPages,
                    $sample->excessPages(),
                    $sample->liveSlotCount);
            }
            exit(0);
        } catch (\Throwable $e) {
            fwrite(STDERR, "stardust: spread:report failed: " . $e->getMessage() . "\n");
            exit(1);
        }

    case 'tick':
        try {
            $flags = $parseFlags(array_slice($argv, 2));
            $budget = isset($flags['budget']) && is_string($flags['budget']) ? (int) $flags['budget'] : null;
            $advisories = isset($flags['advisories']);
            $exports = isset($flags['exports']);

            // --exports needs the reconnect factory too, for the same
            // reason the standalone `chronicler` command does (ADR
            // 0025) — a transient DB disconnect mid-export inside a
            // tick round should recover in-process rather than failing
            // the whole run.
            $pdo = $buildPdo();
            $stardust = new \StarDust\StarDust(new \StarDust\Config\Config(
                pdo: $pdo,
                pdoConnector: $exports ? $buildConnector() : null,
            ));
            $report = $stardust->tick($budget, $advisories, $exports);

            if ($report->stopReason === \StarDust\Daemon\TickStopReason::LOCK_CONTENDED) {
                // Routine, not an error: an overlapping cron firing (or a
                // persistent watcher/liberator process already running)
                // is expected, and a non-zero exit every firing would
                // mean cron mail every firing.
                echo "stardust: tick skipped — a watcher or liberator process already holds its pid file.\n";
                exit(0);
            }

            printf(
                "stardust: tick complete — %d round(s) in %.1fs (budget %ds), stopped: %s.\n",
                $report->rounds,
                $report->elapsedSeconds,
                $report->budgetSeconds,
                $report->stopReason->value,
            );
            exit(0);
        } catch (\Throwable $e) {
            fwrite(STDERR, "stardust: tick failed: " . $e->getMessage() . "\n");
            exit(1);
        }

    default:
        fwrite(STDERR, "stardust: command '{$command}' is not implemented in this build.\n");
        fwrite(STDERR, "Run `bin/stardust --help` for the current command surface.\n");
        exit(2);
}
