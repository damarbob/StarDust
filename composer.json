{
    "name": "damarbob/stardust",
    "description": "Filterable user-defined fields for PHP on MySQL and MariaDB. Records are stored as JSON, and filterable fields are mirrored into indexed columns.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "custom-fields",
        "user-defined-fields",
        "dynamic-fields",
        "eav",
        "multi-tenant",
        "saas",
        "mysql",
        "mariadb",
        "json",
        "vertical-partitioning",
        "stardust"
    ],
    "homepage": "https://stardust.konstelasi.co.id",
    "authors": [
        {
            "name": "Damar Syah Maulana",
            "email": "ibn.damr@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/damarbob/StarDust/issues",
        "docs": "https://stardust.konstelasi.co.id/docs/",
        "source": "https://github.com/damarbob/StarDust"
    },
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "psr/log": "^3.0",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "opis/json-schema": "^2.3",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "StarDust\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StarDust\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/stardust"
    ],
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
